---
interface Props {
    text: string;
    variant?: "primary" | "secondary";
    type?: "button" 
}

const {
    text,
    variant = "primary",
    type = "button"
} = Astro.props;
---

<button type={type} class={`btn btn-${variant}`}>
    {text}
</button>

<style>
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
        width: 154px;
        margin: 10px 30px 10px 30px;
    }

    .btn-primary {
        background-color: var(--color-primary);
        color: var(--color-background);
    }

    .btn-secondary {
        background-color: transparent;
        border: var(--color-primary) solid ;
        color: var(--color-primary);
    }
</style>